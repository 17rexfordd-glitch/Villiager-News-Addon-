+	private static final class VariantShuffleBag {
+		private final ArrayDeque<Integer> entries = new ArrayDeque<>();
+		private int mode = Integer.MIN_VALUE;
+
+		DialogueCatalog.DialogueVariant next(DialogueCatalog.DialogueGroup group, int rareMode, Set<Integer> excluded) {
+			if (mode != rareMode || entries.isEmpty()) refill(group, rareMode);
+			if (entries.isEmpty()) return group.chooseVariant(rareMode, excluded);
+
+			int attempts = entries.size();
+			while (attempts-- > 0) {
+				int index = entries.removeFirst();
+				if (excluded.contains(index)) {
+					entries.addLast(index);
+					continue;
+				}
+				DialogueCatalog.DialogueVariant chosen = findVariant(group, index);
+				if (chosen != null) return chosen;
+			}
+
+			DialogueCatalog.DialogueVariant fallback = group.chooseVariant(rareMode, excluded);
+			return fallback != null ? fallback : group.chooseVariant(rareMode);
+		}
+
+		private void refill(DialogueCatalog.DialogueGroup group, int rareMode) {
+			entries.clear();
+			mode = rareMode;
+			if (group.variants().isEmpty()) return;
+
+			int minimum = group.variants().stream().mapToInt(DialogueCatalog.DialogueVariant::weight).min().orElse(1);
+			int maximum = group.variants().stream().mapToInt(DialogueCatalog.DialogueVariant::weight).max().orElse(1);
+			List<Integer> weights = new ArrayList<>(group.variants().size());
+			int gcd = 0;
+			for (DialogueCatalog.DialogueVariant variant : group.variants()) {
+				int weight = effectiveWeight(variant.weight(), minimum, maximum, rareMode);
+				weights.add(weight);
+				if (weight > 0) gcd = gcd == 0 ? weight : gcd(gcd, weight);
+			}
+			if (gcd <= 0) gcd = 1;
+
+			List<Integer> refill = new ArrayList<>();
+			for (int i = 0; i < group.variants().size(); i++) {
+				int weight = weights.get(i);
+				if (weight <= 0) continue;
+				int copies = Math.max(1, weight / gcd);
+				for (int copy = 0; copy < copies; copy++) refill.add(group.variants().get(i).index());
+			}
+			Collections.shuffle(refill, ThreadLocalRandom.current());
+			entries.addAll(refill);
+		}
+
+		private static DialogueCatalog.DialogueVariant findVariant(DialogueCatalog.DialogueGroup group, int index) {
+			for (DialogueCatalog.DialogueVariant variant : group.variants()) {
+				if (variant.index() == index) return variant;
+			}
+			return null;
+		}
+
+		private static int effectiveWeight(int weight, int minimum, int maximum, int rareMode) {
+			if (rareMode == 0 && weight < maximum * 0.8) return 0;
+			if (rareMode == 2) return maximum + minimum - weight;
+			return Math.max(0, weight);
+		}
+
+		private static int gcd(int a, int b) {
+			while (b != 0) {
+				int next = a % b;
+				a = b;
+				b = next;
+			}
+			return Math.abs(a);
+		}
+	}
